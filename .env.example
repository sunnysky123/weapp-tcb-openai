# ===== CloudBase 凭证（必填）=====
# 云开发环境 ID
TCB_ENV_ID=
# 腾讯云 API 密钥（https://console.cloud.tencent.com/cam/capi）
# 在云函数/云托管中运行时可留空（自动使用环境内身份）
TCB_SECRET_ID=
TCB_SECRET_KEY=

# ===== 服务配置（可选）=====
# 监听端口，默认 8090
PORT=8090
# 保护本地端口的 Bearer Token；留空则不鉴权。
# 供 agent 接入时，把这里填的值作为 API Key 使用
API_KEY=
# 默认模型（客户端未指定 model 时使用），默认 hy3
DEFAULT_MODEL=hy3
# SDK 请求超时（毫秒），AI 生成耗时较长，建议 >= 60000
TCB_TIMEOUT=300000

# ===== 模型别名映射（可选，JSON 格式）=====
# 把客户端请求的 model 名映射为 CloudBase 实际模型名，
# 便于让只认 OpenAI 模型名的工具直接使用。例：
# MODEL_MAP={"gpt-4o":"hy3","gpt-4o-mini":"deepseek-v3.2"}
MODEL_MAP=

# ===== 工具调用模式（可选）=====
# auto    ：优先走 SDK 原生 tool_calls，不可用时自动降级为提示词注入（默认）
# native  ：强制原生模式
# prompt  ：强制提示词注入模式
TOOLS_MODE=auto
